---
const { ctaHref = "#", ctaLabel = "Prenota" } = Astro.props;
import { siteConfig } from "../config/siteConfig";

const base = import.meta.env.BASE_URL;
---

<header class="topbar">
  <a class="logoBox" href={base}>
    <img src={`${base.replace(/\/$/, "")}${siteConfig.logoImage}`} alt={`Logo ${siteConfig.brand}`}>
  </a>

  <div class="topActions">
    <a class="topCta" href={ctaHref} target="_blank" rel="noopener">{ctaLabel}</a>

    <button
      class="burger"
      aria-label="Apri menu"
      onclick="document.body.classList.toggle('menu-open')"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<nav class="menu" aria-label="Menu">
  <a href={base}>Home</a>
  <a href={`${base}/chi-siamo`}>Chi siamo</a>
  <a href={`${base}/servizi`}>Servizi</a>
  <a href={`${base}/galleria`}>Galleria</a>
  <a href={`${base}/contatti`}>Contatti</a>
</nav>

<script>
  document.querySelectorAll(".menu a").forEach(a => {
    a.addEventListener("click", () => document.body.classList.remove('menu-open'));
  });
</script>