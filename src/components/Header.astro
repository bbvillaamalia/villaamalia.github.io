---
const { ctaHref = "#", ctaLabel = "Prenota" } = Astro.props;
import { siteConfig } from "../config/siteConfig";

const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
const cleanBase = baseWithSlash; // alias più chiaro
---

<header class="topbar">
  <a class="logoBox" href={cleanBase}>
    <img src={`${cleanBase}${siteConfig.logoImage.replace(/^\//, "")}`} alt={`Logo ${siteConfig.brand}`}>
  </a>

  <div class="topActions">
    <a class="topCta" href={ctaHref} target="_blank" rel="noopener">{ctaLabel}</a>

    <button
      class="burger"
      aria-label="Apri menu"
      onclick="document.body.classList.toggle('menu-open')"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<nav class="menu" aria-label="Menu">
  <a href={cleanBase}>Home</a>
  <a href={`${cleanBase}chi-siamo`}>Chi siamo</a>
  <a href={`${cleanBase}servizi`}>Servizi</a>
  <a href={`${cleanBase}galleria`}>Galleria</a>
  <a href={`${cleanBase}contatti`}>Contatti</a>
</nav>

<script>
  document.querySelectorAll(".menu a").forEach(a => {
    a.addEventListener("click", () => document.body.classList.remove('menu-open'));
  });
</script>