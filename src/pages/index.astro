---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig, getWhatsAppLink } from "../config/siteConfig";

const prenotaHref = getWhatsAppLink();
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
const heroUrl = `${baseWithSlash}${siteConfig.heroImage.replace(/^\//, "")}`;
const logoUrl = `${baseWithSlash}${siteConfig.logoImage.replace(/^\//, "")}`;
---

<BaseLayout title="">
  <main class="hero" style={`background-image: url('${heroUrl}')`}>
    <div class="overlay"></div>

    <section class="heroInner">

      <!-- LOGO CENTRALE -->
      <img src={logoUrl} alt="Villa Amalia" class="heroLogo" />

      <h1 class="brand">{siteConfig.brand}</h1>

      <p class="headline">
        Benvenuti a <strong>{siteConfig.brand}</strong>, la vostra oasi di
        relax e comfort nel cuore di <strong>{siteConfig.city}</strong>.
      </p>

      <a class="ctaUnderline" href={prenotaHref} target="_blank" rel="noopener">
        Prenota Adesso
      </a>

    </section>
  </main>
</BaseLayout>